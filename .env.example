# SQLite-база проекта (файл создаётся prisma db push)
DATABASE_URL="file:./dev.db"

# Секрет для подписи сессий. Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me"

# Ключ планировщика /api/cron. Без него эндпоинт отвечает 401 — это
# осознанно: забытая конфигурация не должна открывать публичную кнопку
# «разослать уведомления всем». Сгенерировать: openssl rand -base64 24
CRON_SECRET="dev-only-cron-secret"

# Сколько дней живёт сессия
SESSION_TTL_DAYS="30"
